    {
      "id": "3c2af76d-38e2-8025-a06b-c980b74149a2",
      "type": "paragraph",
      "has_children": false,
      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "창고 순찰 로봇을 예로 들어보겠습니다.",
              "link": null
