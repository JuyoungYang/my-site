      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "로봇에게 이렇게 지시했다고 가정해봅시다.",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "로봇에게 이렇게 지시했다고 가정해봅시다.",
