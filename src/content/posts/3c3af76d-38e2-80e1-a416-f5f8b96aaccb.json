        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "피지컬 AI는 결국 로봇이 현실 세계와 어떻게 상호작용하는가의 문제입니다. 이번 편에서는 그 상호작용이 실제로 어떤 구조로 이루어지는지 정리해봤습니다.",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "피지컬 AI는 결국 로봇이 현실 세계와 어떻게 상호작용하는가의 문제입니다. 이번 편에서는 그 상호작용이 실제로 어떤 구조로 이루어지는지 정리해봤습니다.",
