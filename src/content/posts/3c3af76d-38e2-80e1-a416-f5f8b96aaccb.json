          {
            "type": "text",
            "text": {
              "content": "셋째, 행동 생성: 실제로 무엇을 할지 정하기",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
